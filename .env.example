# ══════════════════════════════════════════════════════
#  Dadajon Tort Backend — .env.example
#  Bu faylni .env ga nusxalab to'ldiring (lokal uchun)
#  Productionda (Render) bu qiymatlar Dashboard > Environment bo'limiga kiritiladi — .env fayl kerak emas
# ══════════════════════════════════════════════════════

PORT=5000
NODE_ENV=production

# Murakkab va tasodifiy sir so'z o'ylab toping (kamida 32 belgi)
JWT_SECRET=

# PostgreSQL — Neon.tech (bepul tier):
# neon.tech → New Project → Connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Telegram Bot — @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=Dadajon_Cafebot
# Frontend (Vercel) manzili — bot shu yerga olib boradi
MINI_APP_URL=https://your-frontend.vercel.app/
# CORS uchun — frontend manzili
CLIENT_URL=https://your-frontend.vercel.app

# ═══════════════════════════════════════════════════
#  BOSH OPERATOR — Render'da MAJBURIY o'rnatiladi
#  Shu raqamli foydalanuvchi Operator panelga to'liq huquq bilan kiradi
#  (boshqa operatorlar qo'sha oladi, mahsulot/buyurtmalarni boshqaradi).
#  Format: 9 xonali, kod bilan (masalan Toshkent uchun 901234567)
# ═══════════════════════════════════════════════════
MAIN_OPERATOR_PHONE=

# Ixtiyoriy — bot va operator yordam xabarlarida ko'rsatiladi
SHOP_NAME=Dadajon Tort
ADMIN_TELEGRAM=@your_admin_username
